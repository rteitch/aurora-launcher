<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Whitelisting only datastore preferences automatically excludes the SQLite database (search_history, usage, lock flags). -->
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
